build/
pda-theme.cfg
compile_commands.json
third_party/lvgl/
tools/rgb565_pack
tools/__pycache__/

# map imagery: everything is committed, except the two levels that exceed
# GitHub's 100 MB per-file limit - those are stored as .part files instead
# (tools/fetch_deps.sh reassembles them).
assets/maps/madeira-island/z14.rgb565
assets/maps/funchal/z17.rgb565

# the radio's demo tracks are copyrighted MP3s: the folder ships, the audio
# is dropped in locally (PDA_MUSIC_ROOT, settings) and is not published.
music/**/*.mp3

# the live NWC test's credential (the user's Alby export URI): harness-only,
# never read by the app, deleted with its STATUS.md Blockers line when the
# live testing is done
.keys
# the live NIP-46 test's credential (a real bunker:// token): harness-only,
# never read by the app, deleted with its STATUS.md Blockers line when the
# live testing is done
.keys.nip46
